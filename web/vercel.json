{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/download/mac", "destination": "https://github.com/155xp/pinion/releases/latest/download/Pinion-macos-arm64.dmg" },
    { "source": "/download/windows", "destination": "https://github.com/155xp/pinion/releases/latest/download/Pinion-windows-x64-setup.exe" },
    { "source": "/download/linux", "destination": "https://github.com/155xp/pinion/releases/latest/download/Pinion-linux-amd64.deb" },
    { "source": "/download/voice/mac", "destination": "https://github.com/155xp/pinion/releases/latest/download/Pinion-Voice-macos-arm64.dmg" },
    { "source": "/download/voice/windows", "destination": "https://github.com/155xp/pinion/releases/latest/download/Pinion-Voice-windows-x64-setup.exe" },
    { "source": "/download/voice/linux", "destination": "https://github.com/155xp/pinion/releases/latest/download/Pinion-Voice-linux-amd64.deb" }
  ]
}
