{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinion",
  "version": "0.1.0",
  "identifier": "com.ericomg.pinion",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:ui",
    "beforeDevCommand": {
      "script": "npm run dev:ui",
      "wait": false
    }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A quiet place to write",
    "longDescription": "Pinion is a small, quiet notes app. Notes are plain markdown files with [[links]], so Obsidian can open the same folder.",
    "publisher": "ericomg",
    "homepage": "https://pinion.ericomg.com",
    "license": "MIT",
    "copyright": "\u00a9 2026 ericomg",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
